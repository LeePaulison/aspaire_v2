BETTER_AUTH_SECRET=
BETTER_AUTH_URL="http://localhost:3000" # APP URL

NEXT_PUBLIC_AUTH_URL=http://localhost:3000

JWT_ISSUER=aspaire-web
JWT_AUDIENCE=aspaire-ai-server
ENABLE_EMAIL_PASSWORD_AUTH=false

# Hosted production integration:
# NEXT_PUBLIC_WS_SERVER="wss://aspaire-ai.example.com/ws"

# Active local development:
NEXT_PUBLIC_WS_SERVER="ws://localhost:8080/ws"

# GitHub OAuth
# Get credentials from: https://github.com/settings/developers
# Local callback: http://localhost:3000/api/auth/callback/github
# Optional for MVP; set NEXT_PUBLIC_ENABLE_GITHUB_AUTH=true to show the button.
NEXT_PUBLIC_ENABLE_GITHUB_AUTH=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth
# Get credentials from: https://console.cloud.google.com/apis/credentials
# Local callback: http://localhost:3000/api/auth/callback/google
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MongoDB Community on Fly.io
MONGODB_URI=
MONGODB_DATABASE=aspaire

# Recommended for most uses
DATABASE_URL=

# For uses requiring a connection without pgbouncer
DATABASE_URL_UNPOOLED=

# Resume originals storage
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_RESUME_BUCKET=
RESUME_UPLOAD_MAX_BYTES=5242880
